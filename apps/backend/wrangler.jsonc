{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropsei-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "dev": {
    "port": 3000,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
}
